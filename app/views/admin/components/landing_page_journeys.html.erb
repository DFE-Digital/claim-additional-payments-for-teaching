<% content_for(:page_title) { page_title("Customer journeys") } %>

<% landing_page_journeys = Journeys.landing_page_journeys %>

<p class="govuk-body">
  <%= link_to "Back", root_path, class: "govuk-back-link" %>
</p>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">Customer journeys</h1>

    <p class="govuk-body">
      Use these links to open the main customer journey start pages directly.
    </p>

    <ul class="govuk-list govuk-list--bullet">
      <% landing_page_journeys.each do |journey| %>
        <li>
          <%= govuk_link_to journey.full_name, journey.start_page_url %>
          <span class="govuk-body-s govuk-!-margin-left-2">
            (<%= govuk_link_to "Go to start of journey", admin_components_open_component_path(journey: journey.routing_name, slug: journey.slug_sequence::SLUGS.first) %>)
          </span>
        </li>
      <% end %>
      <li>
        <%= govuk_link_to "Further Education provider dashboard", further_education_payments_providers_claims_path %>
      </li>
    </ul>
  </div>
</div>
