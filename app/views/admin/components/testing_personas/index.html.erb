<% content_for(:page_title) { page_title("Testing personas") } %>
<% content_for(:back_link) { govuk_back_link(href: root_path) } %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">Testing personas</h1>

    <p class="govuk-body">
      Each persona is a type of user we have built a Capybara test for. These are the automated tests that simulate a user's interactions with the system.
    </p>

    <%= govuk_table do |table| %>
      <%= table.with_head do |head| %>
        <%= head.with_row do |row| %>
          <%= row.with_cell(header: true, text: "Journey") %>
          <%= row.with_cell(header: true, text: "Successful", numeric: true) %>
          <%= row.with_cell(header: true, text: "Ineligible", numeric: true) %>
        <% end %>
      <% end %>

      <%= table.with_body do |body| %>
        <% @journeys.each do |journey| %>
          <% personas = journey_personas(journey) %>
          <%= body.with_row do |row| %>
            <%= row.with_cell do %>
              <%= govuk_link_to journey.full_name, admin_components_testing_persona_path(journey: journey.name.parameterize) %>
            <% end %>
            <%= row.with_cell(text: personas.count { |persona| persona[:outcome] == "success" }.to_s, numeric: true) %>
            <%= row.with_cell(text: personas.count { |persona| persona[:outcome] != "success" }.to_s, numeric: true) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
