<% content_for(:page_title) { page_title("Manage #{journey_configuration.journey.full_name}") } %>

<% content_for :back_link do %>
  <%= govuk_back_link href: admin_journey_configurations_path %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl">
      <span class="govuk-caption-xl">Manage services</span>
      <%= journey_configuration.journey.full_name %>
    </h1>

    <% if journey_configuration.open_for_submissions? %>
      <%= govuk_panel(
        title_text: "Service open",
        text: "This service is currently open and accepting claims for the #{journey_configuration.current_academic_year} academic year.",
        classes: "govuk-panel--informational govuk-panel--small"
      ) %>
    <% else %>
      <%= govuk_panel(
        title_text: "Service closed",
        text: "This service is currently closed. Users can not submit claims.",
        classes: "govuk-panel--informational govuk-panel--small"
      ) %>
    <% end %>

    <% if journey_configuration.targeted_retention_incentive_payments? %>
      <div class="govuk-panel govuk-panel--informational govuk-panel--small">
        <% if targeted_retention_incentive_awards_last_updated_at %>
          <p class="govuk-panel__body">
            The <%= I18n.t("targeted_retention_incentive_payments.policy_short_name") %> school award amounts for academic year <%= journey_configuration.current_academic_year %> were updated on <%= l(targeted_retention_incentive_awards_last_updated_at) %>.
          </p>
        <% else %>
          <p class="govuk-panel__body">
            No <%= I18n.t("targeted_retention_incentive_payments.policy_short_name") %> school award data has been uploaded for academic year <%= journey_configuration.current_academic_year %>.
          </p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @form,
      url: admin_journey_configuration_path(journey_configuration),
      method: :patch,
      scope: "journey_configuration",
      builder: GOVUKDesignSystemFormBuilder::FormBuilder do |f| %>

      <%= f.govuk_collection_select :current_academic_year,
        @form.academic_year_select_options,
        :id,
        :name,
        label: { text: "Accepting claims for academic year" } %>

      <%= f.govuk_radio_buttons_fieldset(
        :open_for_submissions,
        legend: {
          size: 'm',
          text: "Service status"
        }) do %>
        <%= f.govuk_radio_button :open_for_submissions,
          true,
          label: { text: "Open" },
          link_errors: true do %>
            <%= render "admin/journey_configurations/reminder_warning" %>
        <% end %>

        <%= f.govuk_radio_button :open_for_submissions,
          false,
          label: { text: "Closed" } do %>
          <%= f.govuk_text_area :availability_message,
            label: {
              text: "Availability message"
            },
            hint: -> do %>
              <p>
                This is an optional message that should provide an explanation of why the service is closed and / or when we expect it to open again.
              </p>

              <p>
                For example, "The service is closed for maintenance and will be available from 2pm today."
              </p>
          <% end %>
        <% end %>
      <% end %>

      <% if journey_configuration.teacher_id_configurable? %>
        <%= f.govuk_collection_radio_buttons :teacher_id_enabled,
          @form.teacher_id_radio_options,
          :id,
          :name,
          legend: { text: "Sign in with DfE Identity" } %>
      <% end %>

      <%= f.govuk_submit "Save" %>
    <% end %>
  </div>
</div>

<% if lookup_context.exists?("admin/journey_configurations/_edit_#{journey_configuration.routing_name.underscore}") %>
  <%= render partial: "admin/journey_configurations/edit_#{journey_configuration.routing_name.underscore}" %>
<% end %>

<hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible">

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h2 class="govuk-heading-m">Create a service access link</h2>

    <%= govuk_button_to(
      "Generate a new service access link",
      admin_service_access_links_path(journey: journey_configuration.routing_name)
    ) %>
  </div>
</div>
