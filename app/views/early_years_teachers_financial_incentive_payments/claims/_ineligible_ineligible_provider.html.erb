<% @backlink_path = claim_path(current_journey_routing_name, "nursery-search") %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">
      <%= @form.t([@form.ineligibility_reason, "heading"]) %>
    </h1>

    <p class="govuk-body">
      Based on our records, the nursery you selected is not currently eligible for the early years teacher recognition payment.
    </p>

    <p class="govuk-body">
      To be eligible, you must teach at an early years group-based setting that offers the early years entitlements.
    </p>

    <p class="govuk-body">
      If you think your nursery is eligible, check the spelling and try searching
      again.
    </p>

    <p class="govuk-body">
      Check the
      <%= govuk_link_to(
        "eligibility criteria",
        t("early_years_teachers_financial_incentive_payments.guidance_url")
      ) %>
      for more information.
    </p>

    <p class="govuk-body">
      If this continues, email us at <%= govuk_mail_to(
        "early_years_teachers_financial_incentive_payments.support_email_address"
      ) %>
    </p>
  </div>
</div>
