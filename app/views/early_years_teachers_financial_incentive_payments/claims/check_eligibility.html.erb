<% content_for(
  :page_title,
  page_title(
    @form.t(:title),
    journey: current_journey_routing_name,
    show_error: @form.errors.any?
  )
) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with model: @form, url: @form.url, builder: GOVUKDesignSystemFormBuilder::FormBuilder do |f| %>
      <%= f.govuk_error_summary %>

      <h1 class="govuk-heading-xl">
        <%= @form.t(:title) %>
      </h1>

      <p class="govuk-body">
        You must meet the eligibility criteria for the early years teacher recognition payment.
      </p>

      <p class="govuk-body">To be eligible, you must:</p>

      <%= govuk_list [
        "spend at least half of your working time fulfilling the role of an early years teacher, as set out in the Early years teacher standards",
        "not be subject to any formal performance management or disciplinary action"
      ], type: :bullet, classes: "govuk-!-margin-bottom-6" %>

      <%= f.govuk_radio_buttons_fieldset :meets_eligibility_criteria,
        legend: { text: "Do you meet this eligibility criteria?", tag: "h2", size: "m" } do %>
        <%= f.govuk_radio_button :meets_eligibility_criteria, true, label: { text: "Yes" } %>
        <%= f.govuk_radio_button :meets_eligibility_criteria, false, label: { text: "No" } %>
      <% end %>

      <%= f.govuk_submit "Confirm and continue" %>
    <% end %>
  </div>
</div>
