<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">
      Your claims
    </h1>

    <% @form.claims.each do |claim| %>
      <%= govuk_summary_card(title: "Claim #{claim.reference}") do |card| %>

        <% card.with_summary_list.with_row do |row| %>
          <% row.with_key { "Claim type" } %>
          <% row.with_value { claim.policy.short_name } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
