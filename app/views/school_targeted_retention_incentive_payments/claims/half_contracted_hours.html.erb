<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with(
      model: @form,
      url: @form.url,
      builder: GOVUKDesignSystemFormBuilder::FormBuilder
    ) do |f| %>
      <%= f.govuk_error_summary %>

      <%= f.govuk_collection_radio_buttons :half_contracted_hours,
        @form.radio_options,
        :id,
        :name,
        legend: {
          text: "Do you spend at least half of your contracted hours teaching chemistry, computing, mathematics or physics?",
          tag: "h1",
          size: "l"
        } %>

      <%= f.govuk_submit %>
    <% end %>
  </div>
</div>
